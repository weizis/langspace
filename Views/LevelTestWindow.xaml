<Window x:Class="LangSpace.Views.LevelTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LangSpace.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Тест на уровень языка" 
        Height="800" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" 
                   Text="Определение уровня языка" 
                   FontSize="32" 
                   FontWeight="Bold"
                   Foreground="#4807FF"
                   FontFamily="{DynamicResource BloggerBold}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
        <TextBlock Grid.Row="1" 
                   x:Name="txtProgress"
                   Text="Вопрос 1 из 24"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#7D56EB"
                   FontFamily="{DynamicResource ManropeMedium}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="2" 
                Background="#EEE9FD" 
                CornerRadius="30" 
                Padding="30"
                BorderThickness="0">
            <StackPanel>
                <TextBlock x:Name="txtQuestion" 
                           Text="Здесь будет вопрос" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="#2D3436"
                           FontFamily="{DynamicResource ManropeBold}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,40"/>
                <RadioButton x:Name="rbA" GroupName="Answers" Margin="0,15" FontSize="22" 
                             Foreground="#333333" FontFamily="{DynamicResource ManropeRegular}">
                    <TextBlock x:Name="txtOptionA" Text="A. Вариант ответа" TextWrapping="Wrap"/>
                </RadioButton>
                <RadioButton x:Name="rbB" GroupName="Answers" Margin="0,15" FontSize="22" 
                             Foreground="#333333" FontFamily="{DynamicResource ManropeRegular}">
                    <TextBlock x:Name="txtOptionB" Text="B. Вариант ответа" TextWrapping="Wrap"/>
                </RadioButton>
                <RadioButton x:Name="rbC" GroupName="Answers" Margin="0,15" FontSize="22" 
                             Foreground="#333333" FontFamily="{DynamicResource ManropeRegular}">
                    <TextBlock x:Name="txtOptionC" Text="C. Вариант ответа" TextWrapping="Wrap"/>
                </RadioButton>
                <RadioButton x:Name="rbD" GroupName="Answers" Margin="0,15" FontSize="22" 
                             Foreground="#333333" FontFamily="{DynamicResource ManropeRegular}">
                    <TextBlock x:Name="txtOptionD" Text="D. Вариант ответа" TextWrapping="Wrap"/>
                </RadioButton>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,20">
            <Button x:Name="btnCancel" 
                    Content="Отмена" 
                    Width="160" 
                    Height="55"
                    Background="#D2C4FB"
                    Foreground="#7D56EB"
                    FontSize="24"
                    FontWeight="Bold"
                    FontFamily="{DynamicResource BloggerBold}"
                    Click="btnCancel_Click"
                    Cursor="Hand"
                    Margin="0,0,20,0"
                    BorderThickness="0"
                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
            <Button x:Name="btnNext" 
                    Content="Далее" 
                    Width="160" 
                    Height="55"
                    Background="#4807FF"
                    Foreground="White"
                    FontSize="24"
                    FontWeight="Bold"
                    FontFamily="{DynamicResource BloggerBold}"
                    Click="btnNext_Click"
                    Cursor="Hand"
                    BorderThickness="0"
                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>