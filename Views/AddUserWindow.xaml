<Window x:Class="LangSpace.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Добавление пользователя" 
        Width="600" 
        Height="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Width="80" 
                Height="80" 
                CornerRadius="40"
                Background="#EEE9FD"
                HorizontalAlignment="Center"
                Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="AccountPlus" 
                                     Width="45" 
                                     Height="45" 
                                     Foreground="#7D56EB"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
        </Border>

        <TextBlock Grid.Row="1" 
                   Text="Добавление нового пользователя" 
                   FontFamily="{DynamicResource BloggerBold}" 
                   FontSize="32" 
                   Foreground="#333333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <StackPanel Grid.Row="2" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Width="450">

            <TextBox x:Name="txtLastName" 
                     materialDesign:HintAssist.Hint="Фамилия"
                     Margin="0,0,0,15"
                     FontSize="24"
                     Height="55"
                     Style="{StaticResource LargeHintTextBox}"/>

            <TextBox x:Name="txtFirstName" 
                     materialDesign:HintAssist.Hint="Имя"
                     Margin="0,0,0,15"
                     FontSize="24"
                     Height="55"
                     Style="{StaticResource LargeHintTextBox}"/>

            <TextBox x:Name="txtUsername" 
                     materialDesign:HintAssist.Hint="Логин"
                     Margin="0,0,0,15"
                     FontSize="24"
                     Height="55"
                     Style="{StaticResource LargeHintTextBox}"/>

            <TextBox x:Name="txtEmail" 
                     materialDesign:HintAssist.Hint="Email"
                     Margin="0,0,0,15"
                     FontSize="24"
                     Height="55"
                     Style="{StaticResource LargeHintTextBox}"/>

            <PasswordBox x:Name="txtPassword" 
                         materialDesign:HintAssist.Hint="Пароль"
                         Margin="0,0,0,15"
                         FontSize="24"
                         Height="55"
                         Style="{StaticResource LargeHintPasswordBox}"/>

            <PasswordBox x:Name="txtConfirmPassword" 
                         materialDesign:HintAssist.Hint="Подтверждение пароля"
                         Margin="0,0,0,20"
                         FontSize="24"
                         Height="55"
                         Style="{StaticResource LargeHintPasswordBox}"/>

            <ComboBox x:Name="cmbRole" 
          DisplayMemberPath="RoleName"
          SelectedValuePath="IdRole"
          Width="450"
          Height="55"
          FontSize="18"
          FontFamily="{DynamicResource ManropeRegular}"
          materialDesign:HintAssist.Foreground="#7D56EB"
          materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
          BorderBrush="#7D56EB"
          BorderThickness="0 0 0 2"
          Background="Transparent"
          Padding="15,0,15,0"
          VerticalContentAlignment="Center"/>
        </StackPanel>


        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,30,0,0">

            <Button x:Name="btnAdd" 
                    Click="btnAdd_Click"
                    Width="180"
                    Height="50"
                    Margin="0,0,15,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#28A745"
                                CornerRadius="25"
                                BorderThickness="0">
                            <TextBlock Text="Добавить" 
                                       FontFamily="{DynamicResource ManropeBold}"
                                       FontSize="18"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnCancel" 
                    Click="btnCancel_Click"
                    Width="180"
                    Height="50">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                CornerRadius="25"
                                BorderBrush="#7D56EB"
                                BorderThickness="2">
                            <TextBlock Text="Отмена" 
                                       FontFamily="{DynamicResource ManropeBold}"
                                       FontSize="18"
                                       Foreground="#7D56EB"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>