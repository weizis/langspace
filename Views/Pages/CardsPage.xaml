<Page x:Class="LangSpace.Views.Pages.CardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:LangSpace.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1050" d:DesignWidth="1540"
      Title="CardsPage" Loaded="Page_Loaded"
      Background="#F5F5F5">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Page.Resources>
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Width="50" 
                    Height="50" 
                    CornerRadius="25"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="BackButton_Click">
                <materialDesign:PackIcon Kind="ArrowLeftThick" 
                                         Width="30" 
                                         Height="30" 
                                         Foreground="#7D56EB"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" 
                       Text="Карточки" 
                       FontFamily="{DynamicResource BloggerBold}" 
                       FontSize="54" 
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Border Grid.Column="2"
                    Background="#7D56EB" 
                    CornerRadius="25" 
                    Width="70"
                    Height="70"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding UserLevel}" 
                           FontFamily="{DynamicResource ManropeBold}" 
                           FontSize="24" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <WrapPanel Grid.Row="1" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,0,0,30">
            <Grid Width="300" Height="50" Margin="-40,0,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Grid.Column="0" 
                                         Kind="Magnify" 
                                         Width="24" 
                                         Height="24" 
                                         Foreground="#7D56EB" 
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0"/>
                <TextBox Grid.Column="1"
                         Height="50"
                         FontSize="18"
                         FontFamily="{DynamicResource ManropeRegular}"
                         materialDesign:HintAssist.Hint="Поиск"
                         materialDesign:HintAssist.Foreground="#7D56EB"
                         materialDesign:HintAssist.Background="Transparent"
                         materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                         BorderBrush="#7D56EB"
                         BorderThickness="0 0 0 2"
                         CaretBrush="#7D56EB"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Padding="0,0,0,5"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <ComboBox Width="220" 
                      Height="50"
                      FontSize="18"
                      FontFamily="{DynamicResource ManropeRegular}"
                      materialDesign:HintAssist.Foreground="#7D56EB"
                      materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                      BorderBrush="#7D56EB"
                      BorderThickness="0 0 0 2"
                      Background="Transparent"
                      
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding ThemeFilters}"
                      SelectedItem="{Binding SelectedTheme}"
                      Margin="0,0,35,0"/>

            <Button Width="50" 
                    Height="50"
                    Margin="5,0,15,0"
                    Cursor="Hand"
                    Click="btnAdd_Click"
                    Background="#7D56EB"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderThickness="0">
                            <materialDesign:PackIcon Kind="Plus" 
                                                     Width="28" 
                                                     Height="28" 
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Width="140" 
                    Height="50"
                    Margin="0,0,25,0"
                    Cursor="Hand"
                    Click="btnTest_Click"
                    Background="#7D56EB"
                    Foreground="White"
                    FontFamily="{DynamicResource ManropeBold}"
                    FontSize="18"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderThickness="0">
                            <TextBlock Text="Пройти тест"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border CornerRadius="25" 
                    Background="Transparent" 
                    Height="50"
                    Margin="0,0,15,0"
                    Cursor="Hand">
                <CheckBox Content="Только мои приватные"
                          FontFamily="{DynamicResource ManropeMedium}"
                          FontSize="20"
                          Foreground="#7D56EB"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowOnlyPrivate}"/>
            </Border>

            <TextBlock FontSize="22" 
                       FontFamily="{DynamicResource ManropeBold}"
                       Foreground="#7D56EB"
                       VerticalAlignment="Center"
                       Text="{Binding CardsCountText}"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DisplayCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Top"
                                  Margin="0,0,0,10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#EEE9FD" 
                                CornerRadius="25" 
                                Padding="20" 
                                Margin="12"
                                BorderBrush="#643BD7"
                                BorderThickness="1"
                                Width="380"
                                MinHeight="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding IdThemeNavigation.ThemeName}"
                                               FontFamily="{DynamicResource ManropeMedium}"
                                               FontSize="14" 
                                               Foreground="#7D56EB"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Background="#7D56EB"
                                            CornerRadius="12"
                                            Padding="10,5,10,5">
                                        <TextBlock Text="{Binding IdLevelNavigation.LevelName}"
                                                   FontFamily="{DynamicResource ManropeBold}"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="txtCardText" 
                                           Grid.Row="1"
                                           FontFamily="{DynamicResource BloggerBold}" 
                                           FontSize="32" 
                                           Foreground="#333333"
                                           TextWrapping="Wrap"
                                           Text="{Binding DisplayText}"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                <Grid Grid.Row="2" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            CornerRadius="25"
                                            Background="#7D56EB"
                                            Height="40"
                                            Width="140">
                                        <Button Content="Посмотреть" 
                                                Background="Transparent"
                                                Foreground="White"
                                                FontFamily="{DynamicResource ManropeBold}"
                                                FontSize="16"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                Click="StudyCard_Click"
                                                Tag="{Binding}"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" 
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibility}}">
                                        <Button Width="40" Height="40"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="btnEdit_Click"
                                                Tag="{Binding}"
                                                Margin="0,0,10,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="22" Height="22" Foreground="#7D56EB"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="40" Height="40"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="btnDelete_Click"
                                                Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <materialDesign:PackIcon Kind="Delete" Width="22" Height="22" Foreground="#FF6B6B"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>