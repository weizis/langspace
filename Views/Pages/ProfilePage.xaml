<Page x:Class="LangSpace.Views.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1540"
      Title="ProfilePage"
      Background="#F5F5F5"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="60" HorizontalAlignment="Center" Width="800">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" 
                        Width="50" 
                        Height="50" 
                        CornerRadius="25"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonUp="BackButton_Click">
                    <materialDesign:PackIcon Kind="ArrowLeftThick" 
                                             Width="30" 
                                             Height="30" 
                                             Foreground="#7D56EB"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" 
                           Text="Редактирование профиля" 
                           FontFamily="{DynamicResource BloggerBold}" 
                           FontSize="54" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,0,50,0"/>
            </Grid>

            <Border Background="#EEE9FD" 
                    CornerRadius="30" 
                    Padding="40,30" 
                    BorderBrush="#643BD7"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,20" HorizontalAlignment="Center">
                        <Border Width="180" 
                                Height="180" 
                                CornerRadius="90" 
                                Background="#7D56EB"
                                BorderBrush="White"
                                ClipToBounds="True">
                            <Image x:Name="imgAvatar" 
                                   Width="180" 
                                   Height="180" 
                                   Stretch="UniformToFill"
                                   Source="/Images/user.png"/>
                        </Border>
                        <Button x:Name="btnChangeAvatar"
                                Width="32" 
                                Height="32" 
                                Background="#4807FF"
                                BorderBrush="White"
                                BorderThickness="2"    
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Cursor="Hand"
                                Click="btnChangeAvatar_Click"
                                ToolTip="Изменить фото">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="16"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="2">
                                        <materialDesign:PackIcon Kind="Camera" 
                                             Width="14" 
                                             Height="14" 
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel>
                        <StackPanel Margin="60,0,0,12">
                            <TextBlock Text="Логин" 
                                       FontFamily="{DynamicResource ManropeMedium}" 
                                       FontSize="16" 
                                       Foreground="#643BD7"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="tbUsername" 
                                     IsReadOnly="True"
                                     Width="500"
                                     Height="50"
                                     FontSize="22"
                                     FontFamily="{DynamicResource ManropeRegular}"
                                     Background="Transparent"
                                     BorderBrush="#643BD7"
                                     BorderThickness="0 0 0 2"
                                     Padding="15,5,0,5"
                                     HorizontalAlignment="Left"
                                     Cursor="Arrow"/>
                        </StackPanel>
                        <StackPanel Margin="60,0,0,12">
                            <TextBlock Text="Имя" 
                                       FontFamily="{DynamicResource ManropeMedium}" 
                                       FontSize="16" 
                                       Foreground="#643BD7"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="tbFirstName" 
                                     Width="500"
                                     Height="50"
                                     FontSize="22"
                                     FontFamily="{DynamicResource ManropeRegular}"
                                     Background="Transparent"
                                     BorderBrush="#643BD7"
                                     BorderThickness="0 0 0 2"
                                     Padding="15,5,0,5"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Margin="60,0,0,12">
                            <TextBlock Text="Фамилия" 
                                       FontFamily="{DynamicResource ManropeMedium}" 
                                       FontSize="16" 
                                       Foreground="#643BD7"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="tbLastName" 
                                     Width="500"
                                     Height="50"
                                     FontSize="22"
                                     FontFamily="{DynamicResource ManropeRegular}"
                                     Background="Transparent"
                                     BorderBrush="#643BD7"
                                     BorderThickness="0 0 0 2"
                                     Padding="15,5,0,5"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Margin="60,0,0,12">
                            <TextBlock Text="Email" 
                                       FontFamily="{DynamicResource ManropeMedium}" 
                                       FontSize="16" 
                                       Foreground="#643BD7"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="tbEmail" 
                                     Width="500"
                                     Height="50"
                                     FontSize="22"
                                     FontFamily="{DynamicResource ManropeRegular}"
                                     Background="Transparent"
                                     BorderBrush="#643BD7"
                                     BorderThickness="0 0 0 2"
                                     Padding="15,5,0,5"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Margin="60,0,0,12">
                            <TextBlock Text="Новый пароль" 
                                       FontFamily="{DynamicResource ManropeMedium}" 
                                       FontSize="16" 
                                       Foreground="#643BD7"
                                       Margin="0,0,0,3"/>
                            <PasswordBox x:Name="tbNewPassword" 
                                         Width="500"
                                         Height="50"
                                         FontSize="22"
                                         FontFamily="{DynamicResource ManropeRegular}"
                                         materialDesign:HintAssist.Hint="Новый пароль"
                                         Background="Transparent"
                                         BorderBrush="#643BD7"
                                         BorderThickness="0 0 0 2"
                                         Padding="15,5,0,5"
                                         HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Margin="60,0,0,20">
                            <TextBlock Text="Подтверждение пароля" 
                                       FontFamily="{DynamicResource ManropeMedium}" 
                                       FontSize="16" 
                                       Foreground="#643BD7"
                                       Margin="0,0,0,3"/>
                            <PasswordBox x:Name="tbConfirmPassword" 
                                         Width="500"
                                         Height="50"
                                         FontSize="22"
                                         FontFamily="{DynamicResource ManropeRegular}"
                                         materialDesign:HintAssist.Hint="Подтвердите пароль"
                                         Background="Transparent"
                                         BorderBrush="#643BD7"
                                         BorderThickness="0 0 0 2"
                                         Padding="15,5,0,5"
                                         HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0">
                            <Button x:Name="btnSave"
                                    Content="Сохранить"
                                    Width="160"
                                    Height="50"
                                    Background="#7D56EB"  
                                    Click="btnSave_Click"
                                    Foreground="White"
                                    FontSize="20"
                                    Margin="0,0,15,0"
                                    FontFamily="{DynamicResource ManropeBold}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
                            <Button x:Name="btnCancel"
                                    Content="Отмена"
                                    Width="160"
                                    Height="50"
                                    Background="#D2C4FB"
                                    Foreground="#7D56EB"
                                    FontSize="20"
                                    FontFamily="{DynamicResource ManropeBold}"
                                    BorderThickness="0"
                                    Cursor="Hand"  
                                    Click="btnCancel_Click"
                                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>