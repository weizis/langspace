<Page x:Class="LangSpace.Views.Pages.TestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="TestsPage"
      Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" 
                    Width="40" 
                    Height="40" 
                    CornerRadius="20"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="BackButton_Click">
                <materialDesign:PackIcon Kind="ArrowLeftThick" 
                                         Width="24" 
                                         Height="24" 
                                         Foreground="#7D56EB"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" 
                       Text="{Binding Title}" 
                       FontFamily="{DynamicResource BloggerBold}" 
                       FontSize="44" 
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="-30,70, 0,-40"/>
        </Grid>

        <Grid Grid.Row="1">

            <Border VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#EEE9FD"
                    CornerRadius="25"
                    Padding="40"
                    BorderBrush="#643BD7"
                    BorderThickness="2"
                    Visibility="{Binding SelectionPanelVisible}">
                <StackPanel>
                    <TextBlock Text="Выберите тему и уровень для теста" 
                               FontSize="24"
                               FontFamily="{DynamicResource ManropeMedium}"
                               Foreground="#7D56EB"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,45"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ComboBox Width="220" 
                                  Height="50"
                                  FontSize="18"
                                  FontFamily="{DynamicResource ManropeRegular}"
                                  materialDesign:HintAssist.Foreground="#7D56EB"
                                  materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                                  BorderBrush="#7D56EB"
                                  BorderThickness="0 0 0 2"
                                  Background="Transparent"
                                 
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding ThemeFilters}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Margin="0,0,15,0"/>

                        <ComboBox Width="220" 
                                  Height="50"
                                  FontSize="18"
                                  FontFamily="{DynamicResource ManropeRegular}"
                                  materialDesign:HintAssist.Foreground="#7D56EB"
                                  materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                                  BorderBrush="#7D56EB"
                                  BorderThickness="0 0 0 2"
                                  Background="Transparent"
                                  
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding LevelFilters}"
                                  SelectedItem="{Binding SelectedLevel}"
                                  Margin="0,0,15,0"/>

                        
                    </StackPanel>
                    <Button Content="Начать тест"
        Width="200"
        Height="60"
        Background="#7D56EB"
        Foreground="White"
        FontSize="22"
        FontFamily="{DynamicResource ManropeBold}"
        Cursor="Hand"
        BorderThickness="0" Margin="0 50 0 0 "
        Click="btnStartTest_Click"
        Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ProgressText}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#7D56EB"
                       FontFamily="{DynamicResource ManropeMedium}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="-5,50,0,20"
                       Visibility="{Binding ProgressVisible}"/>

            <Border Background="#EEE9FD" 
                    CornerRadius="20" Width="600"
                    Padding="25" 
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Visibility="{Binding GrammarQuestionVisible}">
                <StackPanel>
                    <TextBlock Text="{Binding QuestionText}" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="#2D3436"
                               FontFamily="{DynamicResource ManropeBold}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>
                    <RadioButton GroupName="Answers" Margin="0,10" FontSize="20" 
                                 Foreground="#333333" FontFamily="{DynamicResource ManropeRegular}"
                                 IsChecked="{Binding RbA}">
                        <TextBlock Text="{Binding OptionA}" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton GroupName="Answers" Margin="0,10" FontSize="20" 
                                 Foreground="#333333" FontFamily="{DynamicResource ManropeRegular}"
                                 IsChecked="{Binding RbB}">
                        <TextBlock Text="{Binding OptionB}" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton GroupName="Answers" Margin="0,10" FontSize="20" 
                                 Foreground="#333333" FontFamily="{DynamicResource ManropeRegular}"
                                 IsChecked="{Binding RbC}">
                        <TextBlock Text="{Binding OptionC}" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton GroupName="Answers" Margin="0,10" FontSize="20" 
                                 Foreground="#333333" FontFamily="{DynamicResource ManropeRegular}"
                                 IsChecked="{Binding RbD}">
                        <TextBlock Text="{Binding OptionD}" TextWrapping="Wrap"/>
                    </RadioButton>
                </StackPanel>
            </Border>
            <Border Background="#EEE9FD" 
        CornerRadius="20" Width="600"
        Padding="25" 
        BorderThickness="0"
        VerticalAlignment="Center"
        Visibility="{Binding CardQuestionVisible}">
                <StackPanel>
                    <TextBlock Text="Переведите слово:" 
                   FontSize="18"
                   FontFamily="{DynamicResource ManropeMedium}"
                   Foreground="#7D56EB"
                   Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding WordToTranslate}" 
                   FontSize="36" 
                   FontWeight="Bold"
                   Foreground="#2D3436"
                   FontFamily="{DynamicResource BloggerBold}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,40"/>

                    <TextBox Text="{Binding UserAnswerText, UpdateSourceTrigger=PropertyChanged}" 
                 FontSize="18"
                 FontFamily="{DynamicResource ManropeRegular}"
                 Padding="15"
                 Margin="0,0,0,20"
                 BorderBrush="#7D56EB"
                 BorderThickness="2"
                 Background="White">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                                    <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="15,10,15,10"
                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>
            </Border>

            <Border Background="White"  Width="700" Height="500"
                    CornerRadius="20" 
                    Padding="25" 
                    BorderBrush="#EEE9FD"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    Visibility="{Binding ResultPanelVisible}">
                <StackPanel>
                    <TextBlock Text="{Binding ResultText}" 
                               FontFamily="{DynamicResource BloggerBold}"
                               FontSize="28"
                               Foreground="#333333"
                               TextAlignment="Center"
                               Margin="0,0,0,35"/>
                    <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding MistakesText}" Margin="0 20 0 0"
                                   FontFamily="{DynamicResource ManropeRegular}"
                                   FontSize="22"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,-60,0,60">
            <Button Content="Отмена" 
                    Width="200" 
                    Height="60"
                    Background="#D2C4FB"
                    Foreground="#7D56EB"
                    FontSize="26"
                    FontFamily="{DynamicResource ManropeBold}"
                    Click="btnCancel_Click"
                    Cursor="Hand"
                    Margin="0,0,15,0"
                    BorderThickness="0"
                    Visibility="{Binding CancelButtonVisible}"
                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
            <Button Content="{Binding NextButtonContent}" 
                    Width="200" 
                    Height="60"
                    Background="#7D56EB"
                    Foreground="White"
                    FontSize="26"
                    FontFamily="{DynamicResource ManropeBold}"
                    Click="btnNext_Click"
                    Cursor="Hand"
                    BorderThickness="0"
                    Visibility="{Binding NextButtonVisible}"
                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
            <Button Content="Пройти ещё раз"
                    Width="220"
                    Height="60"
                    Background="#7D56EB"
                    Foreground="White"
                    FontSize="24"
                    FontFamily="{DynamicResource ManropeBold}"
                    Cursor="Hand"
                    BorderThickness="0"
                    Margin="15,0,0,0"
                    Visibility="{Binding RestartButtonVisible}"
                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"
                    Click="btnRestart_Click"/>
        </StackPanel>
    </Grid>
</Page>