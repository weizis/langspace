<Page x:Class="LangSpace.Views.Pages.GrammarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="1050" d:DesignWidth="1540"
      Title="GrammarPage"
      Background="#F5F5F5"
      Loaded="Page_Loaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" 
                    Width="50" 
                    Height="50" 
                    CornerRadius="25"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="BackButton_Click">
                <materialDesign:PackIcon Kind="ArrowLeftThick" 
                                         Width="30" 
                                         Height="30" 
                                         Foreground="#7D56EB"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" 
                       Text="Грамматика" 
                       FontFamily="{DynamicResource BloggerBold}" 
                       FontSize="54" 
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Border Grid.Column="2"
                    Background="#7D56EB" 
                    CornerRadius="25" 
                    Width="70"
                    Height="70"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding UserLevel}" 
                           FontFamily="{DynamicResource ManropeBold}" 
                           FontSize="24" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <WrapPanel Grid.Row="1" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,0,0,30">
            <Grid Width="300" Height="50" Margin="0,0,15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Grid.Column="0" 
                                         Kind="Magnify" 
                                         Width="24" 
                                         Height="24" 
                                         Foreground="#7D56EB" 
                                         VerticalAlignment="Center"
                                        Margin="0,0,5,0"/>
                <TextBox Grid.Column="1"
                         Height="50"
                         FontSize="18"
                         FontFamily="{DynamicResource ManropeRegular}"
                         materialDesign:HintAssist.Hint="Поиск"
                         materialDesign:HintAssist.Foreground="#7D56EB"
                         materialDesign:HintAssist.Background="Transparent"
                         materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                         BorderBrush="#7D56EB"
                         BorderThickness="0 0 0 2"
                         CaretBrush="#7D56EB"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Padding="0,0,0,5"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

          
                <ComboBox Width="220" 
                      Height="50"
                      FontSize="18"
                      FontFamily="{DynamicResource ManropeRegular}"
                      materialDesign:HintAssist.Foreground="#7D56EB"
                      materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                      BorderBrush="#7D56EB"
                      BorderThickness="0 0 0 2"
                      Background="Transparent"
                      Padding="15,0,15,0"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding LevelFilters}"
                      SelectedItem="{Binding SelectedLevel}"/>
                

            <Border CornerRadius="25" 
                    Background="#7D56EB" 
                    Width="50" 
                    Height="50"
                    Margin="0,0,15,0"
                    Cursor="Hand"
                    Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibility}}">
                <Button Background="Transparent"
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="btnAddRule_Click">
                    <materialDesign:PackIcon Kind="Plus" 
                                             Width="24" 
                                             Height="24" 
                                             Foreground="White"/>
                </Button>
            </Border>
            <TextBlock FontSize="18" Margin="20 0 0 0"
                       FontFamily="{DynamicResource ManropeMedium}"
                       Foreground="#7D56EB"
                       VerticalAlignment="Center"
                       Text="{Binding RulesCountText}"/>
        </WrapPanel>
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DisplayRules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Top"
                                    Margin="0,0,0,10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#EEE9FD" 
                                CornerRadius="25" 
                                Padding="25" 
                                Margin="0,0,0,15"
                                BorderBrush="#643BD7"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#7D56EB"
                                        CornerRadius="12"
                                        Padding="15,5"
                                        Margin="0,0,20,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IdLevelNavigation.LevelName}"
                                               FontFamily="{DynamicResource ManropeBold}"
                                               FontSize="14"
                                               Foreground="White"/>
                                </Border>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding RuleName}" 
                                           FontFamily="{DynamicResource BloggerBold}" 
                                           FontSize="22" 
                                           Foreground="#333333"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Border CornerRadius="25"
                                            Background="#7D56EB"
                                            Height="40"
                                            Width="100"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Button Content="Изучать" 
                                                Background="Transparent"
                                                Foreground="White"
                                                FontFamily="{DynamicResource ManropeBold}"
                                                FontSize="14"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                Click="StudyRule_Click"
                                                Tag="{Binding}"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"/>
                                    </Border>
                                    <Button Width="40" Height="40"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="btnEditRule_Click"
                                            Tag="{Binding}"
                                            Visibility="{Binding DataContext.IsTeacher, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibility}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <materialDesign:PackIcon Kind="Pencil" 
                                                                             Width="22" 
                                                                             Height="22" 
                                                                             Foreground="#7D56EB"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="40" Height="40"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="btnDeleteRule_Click"
                                            Tag="{Binding}"
                                            Margin="5,0,0,0"
                                            Visibility="{Binding DataContext.IsTeacher, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibility}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <materialDesign:PackIcon Kind="Delete" 
                                                                             Width="22" 
                                                                             Height="22" 
                                                                             Foreground="#FF6B6B"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>