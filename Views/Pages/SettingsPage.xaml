<Page x:Class="LangSpace.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:LangSpace.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1050" d:DesignWidth="1540"
      Title="SettingsPage"
      Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="60" HorizontalAlignment="Center" Width="1200">

            <Grid Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" 
                        Width="50" 
                        Height="50" 
                        CornerRadius="25"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonUp="BackButton_Click">
                    <materialDesign:PackIcon Kind="ArrowLeftThick" 
                                             Width="30" 
                                             Height="30" 
                                             Foreground="#7D56EB"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" 
                           Text="Настройки" 
                           FontFamily="{DynamicResource BloggerBold}" 
                           FontSize="48" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,0,50,0"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,40,0">

                    <Border Background="#EEE9FD" 
                            CornerRadius="30" 
                            Padding="30" 
                            Width="560"
                            Height="511"
                            Margin="0,0,0,30"
                            BorderBrush="#643BD7"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Учетная запись" 
                                       FontFamily="{DynamicResource BloggerBold}" 
                                       FontSize="44" 
                                       Foreground="#333333"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,30"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Имя:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30"  
                                           Foreground="#333333"/>
                                <TextBox x:Name="tbUsername" Grid.Column="1" Text="" 
                                           FontFamily="{DynamicResource CenturyGothicRegular}" 
                                           FontSize="30" Cursor="Arrow"
                                           Foreground="#333333"  IsReadOnly="True"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Email:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"/>
                                <TextBox x:Name="tbEmail" Grid.Column="1" Text=""  IsReadOnly="True"
                                           FontFamily="{DynamicResource CenturyGothicRegular}" 
                                           FontSize="30" Cursor="Arrow"
                                           Foreground="#333333"/>
                            </Grid>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Пароль:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"/>
                                <TextBlock x:Name="tbPassword" Grid.Column="1" Text=""
                                           FontFamily="{DynamicResource CenturyGothicRegular}" 
                                           FontSize="30" 
                                           Foreground="#333333"/>
                            </Grid>
                            <Grid Margin="0,0,0,40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Уровень языка:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333" Grid.ColumnSpan="2" Margin="0,0,271,0"/>
                                <TextBlock x:Name="tbLevel" Grid.Column="1" Text="" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#7D56EB" Margin="99,0,-10,0"/>
                            </Grid>
                            <Button x:Name="btnEditProfile"
                                    Content="Изменить данные"
                                    Width="388" Click="btnEditProfile_Click"
                                    Height="58"
                                    Background="#7D56EB"
                                    Foreground="White"
                                    FontSize="24"
                                    FontFamily="{DynamicResource ManropeBold}"
                                    HorizontalAlignment="Center"
                                    BorderThickness="0"
                                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EEE9FD" 
                            CornerRadius="30" 
                            Padding="30" 
                            Width="560"
                            Height="254"
                            BorderBrush="#643BD7"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Внешний вид" 
                                       FontFamily="{DynamicResource BloggerBold}" 
                                       FontSize="44" 
                                       Foreground="#333333"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Тема:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbTheme" Grid.Column="1" 
                                          Width="200" Height="50"
                                          FontSize="20"
                                          FontFamily="{DynamicResource ManropeRegular}"
                                          materialDesign:HintAssist.Foreground="#7D56EB"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#643BD7"
                                          BorderBrush="#643BD7"
                                          BorderThickness="0 0 0 2"
                                          Background="Transparent"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Светлая" IsSelected="True"/>
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Язык:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbLanguage" 
                                          Grid.Column="1" 
                                          Width="200" Height="50"
                                          FontSize="20"
                                          FontFamily="{DynamicResource ManropeRegular}"
                                          materialDesign:HintAssist.Foreground="#7D56EB"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#643BD7"
                                          BorderBrush="#643BD7"
                                          BorderThickness="0 0 0 2"
                                          Background="Transparent"
                                          
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Русский" IsSelected="True"/>
                                    
                                </ComboBox>
                               
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">

                    <Border Background="#EEE9FD" 
                            CornerRadius="30" 
                            Padding="30" 
                            Width="560"
                            Height="465"
                            Margin="0,0,0,30"
                            BorderBrush="#643BD7"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Цели обучения" 
                                       FontFamily="{DynamicResource BloggerBold}" 
                                       FontSize="44" 
                                       Foreground="#333333"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,30"/>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Карточек в день:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbCardsPerDay" 
                                          Grid.Column="1" 
                                          Width="190" Height="50" Margin="10 -10 0 0"
                                          FontSize="20"
                                          FontFamily="{DynamicResource ManropeRegular}"
                                          materialDesign:HintAssist.Foreground="#7D56EB"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                                          BorderBrush="#7D56EB"
                                          BorderThickness="0 0 0 2"
                                          Background="Transparent"
                                         
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="15"/>
                                    <ComboBoxItem Content="20" IsSelected="True"/>
                                    <ComboBoxItem Content="25"/>
                                    <ComboBoxItem Content="30"/>
                                    <ComboBoxItem Content="40"/>
                                    <ComboBoxItem Content="50"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Тестов в день:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbTestsPerDay" 
                                          Grid.Column="1" 
                                          Width="190" Height="50" Margin="10 -10 0 0"
                                          FontSize="20"
                                          FontFamily="{DynamicResource ManropeRegular}"
                                          materialDesign:HintAssist.Foreground="#7D56EB"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                                          BorderBrush="#7D56EB"
                                          BorderThickness="0 0 0 2"
                                          Background="Transparent"
                                          Padding="15,0,15,0"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="1" IsSelected="True"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="5"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Дней подряд:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbDaysStreak" 
                                          Grid.Column="1" 
                                          Width="190" Height="50" Margin="10 -10 0 0"
                                          FontSize="20"
                                          FontFamily="{DynamicResource ManropeRegular}"
                                          materialDesign:HintAssist.Foreground="#7D56EB"
                                          materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                                          BorderBrush="#7D56EB"
                                          BorderThickness="0 0 0 2"
                                          Background="Transparent"
                                          Padding="15,0,15,0"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="7" IsSelected="True"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="14"/>
                                    <ComboBoxItem Content="21"/>
                                    <ComboBoxItem Content="30"/>
                                </ComboBox>
                            </Grid>

                            <Button x:Name="btnSaveGoals"
                                    Content="Сохранить цели"
                                    Width="388"
                                    Height="58"
                                    Background="#7D56EB"
                                    Foreground="White"
                                    FontSize="24"
                                    FontFamily="{DynamicResource ManropeBold}"
                                    HorizontalAlignment="Center"
                                    BorderThickness="0"
                                    Click="btnSaveGoals_Click"
                                    Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#EEE9FD" 
                            CornerRadius="30" 
                            Padding="30" 
                            Width="560"
                            Height="299"
                            BorderBrush="#643BD7"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="О приложении" 
                                       FontFamily="{DynamicResource BloggerBold}" 
                                       FontSize="44" 
                                       Foreground="#333333"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,25"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Версия:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"/>
                                <TextBlock Grid.Column="1" Text="1.0.0" 
                                           FontFamily="{DynamicResource CenturyGothicRegular}" 
                                           FontSize="30" 
                                           Foreground="#333333"/>
                            </Grid>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Контакты:" 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" 
                                           Foreground="#333333"/>
                                <TextBlock Grid.Column="1" Text="weizis@mail.ru" 
                                           FontFamily="{DynamicResource CenturyGothicRegular}" 
                                           FontSize="30" 
                                           Foreground="#333333"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text=" " 
                                           FontFamily="{DynamicResource CenturyGothicBold}" 
                                           FontSize="30" Margin="0,0,149,0"/>
                                <TextBlock Text="Политика конфиденциальности" 
                                           FontFamily="{DynamicResource CenturyGothicRegular}" 
                                           FontSize="30" 
                                           Foreground="#7D56EB"
                                           TextDecorations="Underline"
                                           Cursor="Hand" Grid.ColumnSpan="2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>