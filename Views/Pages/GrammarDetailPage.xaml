<Page x:Class="LangSpace.Views.Pages.GrammarDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="900"
      Title="GrammarDetailPage"
      Background="#F5F5F5">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,40,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Width="50" 
                    Height="50" 
                    CornerRadius="25"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="BackButton_Click">
                <materialDesign:PackIcon Kind="ArrowLeftThick" 
                                         Width="30" 
                                         Height="30" 
                                         Foreground="#7D56EB"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="1" 
                       Text="{Binding RuleName}" 
                       FontFamily="{DynamicResource BloggerBold}" 
                       FontSize="54"  Margin="0 30 0 0"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="2"
                    Background="#7D56EB"
                    CornerRadius="12" 
                    Padding="15,8" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding IdLevelNavigation.LevelName}" 
                           FontFamily="{DynamicResource ManropeBold}" 
                           FontSize="16" 
                           Foreground="White"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Center">
            <StackPanel>
                <Border Background="White" 
                        CornerRadius="25" 
                        Padding="30" 
                        Margin="0,0,0,0"
                        BorderBrush="#EEE9FD" 
                        Width="600"
                        BorderThickness="1">
                    <TextBlock Text="{Binding RuleText}" 
                               FontFamily="{DynamicResource ManropeRegular}" 
                               FontSize="24" 
                               Foreground="#333333"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="btnStartTest" 
                Grid.Row="2"
                Content="Пройти тест" 
                Background="#7D56EB"
                Foreground="White"
                FontFamily="{DynamicResource ManropeBold}"
                FontSize="24"
                Cursor="Hand"
                BorderThickness="0"
                Height="60"
                Width="270"
                Margin="0,20,0,40"
                HorizontalAlignment="Center"
                Click="btnStartTest_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="25">
                        <ContentPresenter Content="{TemplateBinding Content}" 
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Page>