<Page x:Class="LangSpace.Views.Pages.NoteEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="NoteEditPage"
      Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,20,0,120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" 
                        Width="50" 
                        Height="50" 
                        CornerRadius="25"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonUp="BackButton_Click">
                    <materialDesign:PackIcon Kind="ArrowLeftThick" 
                                             Width="30" 
                                             Height="30" 
                                             Foreground="#7D56EB"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" 
                           x:Name="tbTitle"
                           Text="Заметка" 
                           FontFamily="{DynamicResource BloggerBold}" 
                           FontSize="44" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" 
                    CornerRadius="25" 
                    Background="White" 
                    BorderBrush="#7D56EB" 
                    BorderThickness="1" 
                    Margin="0,0,0,20" 
                    Height="300" 
                    Width="1000">
                <TextBox x:Name="tbNoteText" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Height="260" 
                         FontSize="24"
                         Padding="15"
                         BorderThickness="0"
                         Background="White" materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                         Foreground="#333333"
                         CaretBrush="#7D56EB"/>
            </Border>

            <StackPanel Grid.Row="2" x:Name="filePanel" Visibility="Collapsed" Margin="0,0,0,20" Width="1000">
                <TextBlock Text="Прикрепленный файл:" 
                           FontFamily="{DynamicResource ManropeMedium}" 
                           FontSize="14" 
                           Foreground="#7D56EB"
                           Margin="0,0,0,10"/>
                <Border CornerRadius="25" Background="#EEE9FD" BorderBrush="#7D56EB" BorderThickness="1">
                    <Grid Margin="15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="FileDocument" Width="24" Height="24" Foreground="#7D56EB" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" 
                                   x:Name="tbFileName" 
                                   FontFamily="{DynamicResource ManropeRegular}" 
                                   FontSize="14" 
                                   Foreground="#7D56EB"
                                   TextDecorations="Underline"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="OpenFile_Click"/>
                    </Grid>
                </Border>
                <Button x:Name="btnReplaceFile" 
                        Content="Заменить файл"
                        Width="200" Height="40"
                        Background="#7D56EB" Foreground="White"
                        FontSize="20"
                        FontFamily="{DynamicResource BloggerMedium}"
                        Click="btnSelectFile_Click" Cursor="Hand"
                        Margin="0,20,0,0"
                        Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="20"
                                    BorderThickness="0">
                                <ContentPresenter Content="{TemplateBinding Content}" 
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="3" x:Name="imagePanel" Visibility="Collapsed" Margin="0,0,0,20" Width="1000">
                <TextBlock Text="Прикрепленное изображение:" 
                           FontFamily="{DynamicResource ManropeMedium}" 
                           FontSize="14" 
                           Foreground="#7D56EB"
                           Margin="0,0,0,10"/>
                <Border CornerRadius="25" Background="#EEE9FD" BorderBrush="#7D56EB" BorderThickness="1" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" 
                               x:Name="imgPreview" 
                               MaxHeight="200" 
                               Stretch="Uniform"
                               Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" 
                                   x:Name="tbImageName" 
                                   FontFamily="{DynamicResource ManropeRegular}" 
                                   FontSize="12" 
                                   Foreground="#7D56EB"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Button x:Name="btnSelectFile" 
                    Grid.Row="4"
                    Content="Выбрать файл"
                    Width="220" Height="45"
                    Background="#4807FF" Foreground="White"
                    FontFamily="{DynamicResource BloggerMedium}" FontSize="20"
                    Click="btnSelectFile_Click" Cursor="Hand"
                    BorderThickness="0" 
                    Margin="0,20,0,100"
                    Visibility="Collapsed">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22.5"
                                BorderThickness="0">
                            <ContentPresenter Content="{TemplateBinding Content}" 
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Row="5" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,20,0,0">
                <Button x:Name="btnSave" 
                        Content="Сохранить" 
                        Width="180" Height="50"
                        Background="#7D56EB" Foreground="White"
                        FontSize="26" FontWeight="Bold" 
                        FontFamily="{DynamicResource BloggerBold}"
                        Click="btnSave_Click" Cursor="Hand"
                        Margin="0,0,15,0"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="25"
                                    BorderThickness="0">
                                <ContentPresenter Content="{TemplateBinding Content}" 
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnDelete" 
                        Content="Удалить" 
                        Width="180" Height="50"
                        Background="#FF6B6B" Foreground="White"
                        FontSize="26" FontWeight="Bold"
                        FontFamily="{DynamicResource BloggerBold}"
                        Click="btnDelete_Click" Cursor="Hand"
                        Margin="0,0,15,0"
                        BorderThickness="0" 
                        Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="25"
                                    BorderThickness="0">
                                <ContentPresenter Content="{TemplateBinding Content}" 
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnCancel" 
                        Content="Отмена" 
                        Width="180" Height="50"
                        Background="#D2C4FB" Foreground="#7D56EB"
                        FontSize="26" FontWeight="Bold"
                        FontFamily="{DynamicResource BloggerBold}"
                        Click="btnCancel_Click" Cursor="Hand"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="25"
                                    BorderThickness="0">
                                <ContentPresenter Content="{TemplateBinding Content}" 
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>