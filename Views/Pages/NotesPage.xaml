<Page x:Class="LangSpace.Views.Pages.NotesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:LangSpace.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1050" d:DesignWidth="1540"
      Title="NotesPage" Loaded="Page_Loaded_1"
      Background="#F5F5F5">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" 
                    Width="50" 
                    Height="50" 
                    CornerRadius="25"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="BackButton_Click">
                <materialDesign:PackIcon Kind="ArrowLeftThick" 
                                         Width="30" 
                                         Height="30" 
                                         Foreground="#7D56EB"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" 
                       Text="Рабочее пространство" 
                       FontFamily="{DynamicResource BloggerBold}" 
                       FontSize="54" 
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,50,0"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,30" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" 
                    x:Name="btnNewNote" Click="btnNewNote_Click"
                    Width="320"
                    Height="100"
                    Background="#A085EA"
                    Foreground="White"
                    FontSize="24"
                    FontFamily="{DynamicResource BloggerMedium}"
                    Margin="0,0,15,0"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Image Source="/Images/add_note.png" Width="80" Height="80" Margin="10,0,10,0"/>
                                <TextBlock Text="Новая заметка" 
                                           FontFamily="{DynamicResource BloggerMedium}"
                                           FontSize="28"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="1" 
                    x:Name="btnAddResource" Click="btnAddResource_Click"
                    Width="320"
                    Height="100"
                    Background="#A085EA"
                    Foreground="White"
                    FontSize="24"
                    FontFamily="{DynamicResource BloggerMedium}"
                    Margin="0,0,15,0"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Image Source="/Images/add_link.png" Width="80" Height="80" Margin="10,0,10,0"/>
                                <TextBlock Text="Добавить ресурс" 
                                           FontFamily="{DynamicResource BloggerMedium}"
                                           FontSize="28"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="2" 
                    x:Name="btnPicNotes" Click="btnPicNotes_Click"
                    Width="320"
                    Height="100"
                    Background="#A085EA"
                    Foreground="White"
                    FontSize="24"
                    FontFamily="{DynamicResource BloggerMedium}"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Image Source="/Images/add_image.png" Width="80" Height="80" Margin="10,0,10,0"/>
                                <TextBlock Text="Добавить картинку" 
                                           FontFamily="{DynamicResource BloggerMedium}"
                                           FontSize="24"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,50">
            <TextBlock Text="Показать:" 
                       FontFamily="{DynamicResource ManropeMedium}" 
                       FontSize="26" 
                       Foreground="#333333"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"/>
            <ComboBox x:Name="cmbFilterType"  SelectionChanged="cmbFilterType_SelectionChanged"
                      Width="250" 
                      Height="50"
                      FontSize="22"
                      FontFamily="{DynamicResource ManropeRegular}"
                      ItemsSource="{Binding FilterTypes}"
                      SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"     
                      materialDesign:HintAssist.Foreground="#7D56EB"
                      materialDesign:TextFieldAssist.UnderlineBrush="#7D56EB"
                      BorderBrush="#7D56EB"
                      BorderThickness="0 0 0 2"
                      Background="Transparent"  
                      VerticalAlignment="Center">

            </ComboBox>
        </StackPanel>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="NotesList" ItemsSource="{Binding DisplayedNotes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#EEE9FD" Width="1000"
                                CornerRadius="25" 
                                Padding="20" 
                                Margin="0,0,0,15"
                                BorderBrush="#643BD7"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding NoteText}" 
                                               FontFamily="{DynamicResource ManropeRegular}" 
                                               FontSize="16" 
                                               Foreground="#333333"
                                               TextWrapping="Wrap"
                                               Margin="0,0,15,0"/>

                                    <StackPanel Grid.Column="1" 
                                                Orientation="Horizontal" 
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding DateCreated, StringFormat='dd.MM.yyyy'}" 
                                                   FontFamily="{DynamicResource ManropeMedium}" 
                                                   FontSize="12" 
                                                   Foreground="#7D56EB"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>

                                        <Button x:Name="btnOpenResource"
                                                Content="Открыть файл"
                                                Background="#4CAF50"
                                                Foreground="White"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Cursor="Hand" 
                                                Width="90"
                                                Height="32"
                                                Click="OpenResource_Click"
                                                Tag="{Binding}"
                                                Margin="10,0,10,0" 
                                                Padding="8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="15"
                                                            BorderThickness="0">
                                                        <ContentPresenter Content="{TemplateBinding Content}" 
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Width="32" 
                                                Height="32"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="EditNote_Click"
                                                Tag="{Binding}"
                                                Margin="5,10,5,0"
                                                VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <materialDesign:PackIcon Kind="Pencil" 
                                                                                 Width="18" 
                                                                                 Height="18" 
                                                                                 Foreground="#7D56EB"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Width="32" 
                                                Height="32"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand" Margin="0,10,0,0"
                                                Click="DeleteNote_Click"
                                                Tag="{Binding}"
                                                VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <materialDesign:PackIcon Kind="Delete" 
                                                                                 Width="18" 
                                                                                 Height="18" 
                                                                                 Foreground="#FF6B6B"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>