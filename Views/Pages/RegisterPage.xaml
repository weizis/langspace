<Page x:Class="LangSpace.Views.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:LangSpace.Views"
      mc:Ignorable="d" 
      d:DesignHeight="1200" d:DesignWidth="800"
      Title="RegisterPage"
      Background="#F5F5F5"
      FontFamily="{DynamicResource ManropeRegular}"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Width="550">
                <Image Source="/Images/LangSpace.png"
                       Width="500" 
                       Height="200" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,-10"/>

                <StackPanel Margin="0,0,0,0">
                    <Grid Margin="0,0,0,20">
                        <TextBox x:Name="txtFirstName"
                                 Width="480"
                                 materialDesign:HintAssist.Hint="Имя"
                                 materialDesign:HintAssist.Foreground="#4300FF"
                                 materialDesign:HintAssist.Background="Transparent"
                                 materialDesign:TextFieldAssist.UnderlineBrush="#4807FF"
                                 FontSize="28"
                                 FontFamily="{DynamicResource ManropeRegular}"
                                 Foreground="#2D3436"
                                 Height="55"
                                 VerticalContentAlignment="Center"
                                 Padding="15,5"
                                 BorderBrush="#4807FF"
                                 BorderThickness="0 0 0 2"
                                 CaretBrush="#4807FF"
                                 HorizontalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <TextBox x:Name="txtLastName"
                                 Width="480"
                                 materialDesign:HintAssist.Hint="Фамилия"
                                 materialDesign:HintAssist.Foreground="#4300FF"
                                 materialDesign:HintAssist.Background="Transparent"
                                 materialDesign:TextFieldAssist.UnderlineBrush="#4807FF"
                                 FontSize="28"
                                 FontFamily="{DynamicResource ManropeRegular}"
                                 Foreground="#2D3436"
                                 Height="55"
                                 VerticalContentAlignment="Center"
                                 Padding="15,5"
                                 BorderBrush="#4807FF"
                                 BorderThickness="0 0 0 2"
                                 CaretBrush="#4807FF"
                                 HorizontalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <TextBox x:Name="txtUsername"
                                 Width="480"
                                 materialDesign:HintAssist.Hint="Логин"
                                 materialDesign:HintAssist.Foreground="#4300FF"
                                 materialDesign:HintAssist.Background="Transparent"
                                 materialDesign:TextFieldAssist.UnderlineBrush="#4807FF"
                                 FontSize="28"
                                 FontFamily="{DynamicResource ManropeRegular}"
                                 Foreground="#2D3436"
                                 Height="55"
                                 VerticalContentAlignment="Center"
                                 Padding="15,5"
                                 BorderBrush="#4807FF"
                                 BorderThickness="0 0 0 2"
                                 CaretBrush="#4807FF"
                                 HorizontalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <TextBox x:Name="txtEmail"
                                 Width="480"
                                 materialDesign:HintAssist.Hint="Эл. почта"
                                 materialDesign:HintAssist.Foreground="#4300FF"
                                 materialDesign:HintAssist.Background="Transparent"
                                 materialDesign:TextFieldAssist.UnderlineBrush="#4807FF"
                                 FontSize="28"
                                 FontFamily="{DynamicResource ManropeRegular}"
                                 Foreground="#2D3436"
                                 Height="55"
                                 VerticalContentAlignment="Center"
                                 Padding="15,5"
                                 BorderBrush="#4807FF"
                                 BorderThickness="0 0 0 2"
                                 CaretBrush="#4807FF"
                                 HorizontalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <PasswordBox x:Name="txtPassword"
                                     Width="480"
                                     materialDesign:HintAssist.Hint="Пароль"
                                     materialDesign:HintAssist.Foreground="#4300FF"
                                     materialDesign:HintAssist.Background="Transparent"
                                     materialDesign:TextFieldAssist.UnderlineBrush="#4807FF"
                                     FontSize="28"
                                     FontFamily="{DynamicResource ManropeRegular}"
                                     Foreground="#2D3436"
                                     Height="55"
                                     VerticalContentAlignment="Center"
                                     Padding="15,5"
                                     BorderBrush="#4807FF"
                                     BorderThickness="0 0 0 2"
                                     CaretBrush="#4807FF"
                                     HorizontalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <PasswordBox x:Name="txtConfirmPassword"
                                     Width="480"
                                     materialDesign:HintAssist.Hint="Подтверждение пароля"
                                     materialDesign:HintAssist.Foreground="#4300FF"
                                     materialDesign:HintAssist.Background="Transparent"
                                     materialDesign:TextFieldAssist.UnderlineBrush="#4807FF"
                                     FontSize="28"
                                     FontFamily="{DynamicResource ManropeRegular}"
                                     Foreground="#2D3436"
                                     Height="55"
                                     VerticalContentAlignment="Center"
                                     Padding="15,5"
                                     BorderBrush="#4807FF"
                                     BorderThickness="0 0 0 2"
                                     CaretBrush="#4807FF"
                                     HorizontalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="btnGeneratePassword"
                            Content="Сгенерировать пароль"
                            Width="310" Height="60"
                            Background="#7D56EB"
                            Foreground="White"
                            FontSize="26"
                            FontFamily="{DynamicResource BloggerMedium}"
                            Margin="0,10,0,10"
                            HorizontalAlignment="Center"
                            Click="btnGeneratePassword_Click"
                            Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
                    <CheckBox x:Name="cbAgree" Style="{StaticResource CustomCheckBoxStyle}"
                              Margin="0,20,0,10"
                              HorizontalAlignment="Center"
                              Width="480">
                        <TextBlock Text="Я принимаю условия пользовательского соглашения"
                                  FontFamily="pack://application:,,,/LangSpace;component/Fonts/#Fedorka"
                                  Foreground="#2D3436"
                                  FontSize="22"
                                  TextWrapping="Wrap"
                                  TextAlignment="Left"/>
                    </CheckBox>
                    <Button x:Name="btnRegister"
                           Content="Зарегистрироваться"
                           Height="65"
                           Width="480"
                           Background="#4807FF"
                           Foreground="White"
                           FontSize="32"
                           FontFamily="{DynamicResource BloggerBold}"
                           Margin="0,15,0,5"
                           HorizontalAlignment="Center"
                           Padding="0,0,0,5"
                           Click="btnRegister_Click"
                           Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
                </StackPanel>
                <Button x:Name="btnLogin"
                       Content="Уже есть аккаунт? Войдите"
                       Height="55"
                       Width="480"
                       Background="#D2C4FB"
                       Foreground="#7D56EB"
                       FontSize="26"
                       FontFamily="{DynamicResource BloggerBold}"
                       Margin="0,10,0,40"
                       HorizontalAlignment="Center"
                       Padding="0,0,0,5"
                       Click="btnLogin_Click"
                       Style="{StaticResource RoundedMaterialDesignRaisedButton}"/>
                
                <StackPanel Margin="0,5,0,10"
                           HorizontalAlignment="Center"
                           Width="480">
                    <Image Source="/Images/handshake.png" 
                           Width="50" 
                           Margin="0,0,0,5" 
                           HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Copyright"
                                                Width="20"
                                                Height="20"
                                                Foreground="#35168C"
                                                VerticalAlignment="Center"/>
                        <TextBlock Text=" 2026 LangSpace" 
                                  FontFamily="{DynamicResource ManropeRegular}"
                                  Foreground="#35168C"
                                  FontSize="18"
                                  VerticalAlignment="Center"
                                  Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Михеева А.В. 9ПО-32" 
                              FontFamily="{DynamicResource ManropeRegular}"
                              Foreground="#35168C"
                              FontSize="18"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>