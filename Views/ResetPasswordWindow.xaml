<Window x:Class="LangSpace.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Сброс пароля" 
        Width="480" 
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Width="70" 
                Height="70" 
                CornerRadius="35"
                Background="#EEE9FD"
                HorizontalAlignment="Center"
                Margin="0,0,0,15">
            <materialDesign:PackIcon Kind="LockReset" 
                                     Width="35" 
                                     Height="35" 
                                     Foreground="#7D56EB"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
        </Border>

        <TextBlock Grid.Row="1" 
                   Text="Сброс пароля" 
                   FontFamily="{DynamicResource BloggerBold}" 
                   FontSize="28" 
                   Foreground="#333333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="2" 
                Background="#EEE9FD" 
                CornerRadius="15" 
                Padding="15"
                Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="Пользователь" 
                           FontFamily="{DynamicResource ManropeMedium}" 
                           FontSize="14" 
                           Foreground="#666"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtUserFullName" 
                           Text="—" 
                           FontFamily="{DynamicResource ManropeBold}" 
                           FontSize="20" 
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" 
                   Text="Новый пароль" 
                   FontFamily="{DynamicResource ManropeMedium}" 
                   FontSize="14" 
                   Foreground="#666"
                   Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtNewPassword" 
                     Grid.Row="4"
                     Height="45"
                     Margin="0,0,0,20"
                     BorderBrush="#D0D0D0"
                     BorderThickness="1"
                     Padding="15,0"
                     FontSize="16"/>

        <TextBlock Grid.Row="5" 
                   Text="Подтверждение пароля" 
                   FontFamily="{DynamicResource ManropeMedium}" 
                   FontSize="14" 
                   Foreground="#666"
                   Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtConfirmPassword" 
                     Grid.Row="6"
                     Height="45"
                     Margin="0,0,0,30"
                     BorderBrush="#D0D0D0"
                     BorderThickness="1"
                     Padding="15,0"
                     FontSize="16"/>

        <StackPanel Grid.Row="7" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button x:Name="btnChange" 
                    Click="btnChange_Click"
                    Width="150"
                    Height="45"
                    Margin="0,0,15,0"
                    Background="#7D56EB"
                    Foreground="White"
                    FontFamily="{DynamicResource ManropeBold}"
                    FontSize="16"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                BorderThickness="0">
                            <TextBlock Text="Изменить" 
                                       FontFamily="{DynamicResource ManropeBold}"
                                       FontSize="16"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnCancel" 
                    Click="btnCancel_Click"
                    Width="150"
                    Height="45"
                    Background="Transparent"
                    Foreground="#7D56EB"
                    BorderBrush="#7D56EB"
                    BorderThickness="2"
                    FontFamily="{DynamicResource ManropeBold}"
                    FontSize="16"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                CornerRadius="22"
                                BorderBrush="#7D56EB"
                                BorderThickness="2">
                            <TextBlock Text="Отмена" 
                                       FontFamily="{DynamicResource ManropeBold}"
                                       FontSize="16"
                                       Foreground="#7D56EB"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>